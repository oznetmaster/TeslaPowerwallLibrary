{
  "schema": 1,
  "tasks": {
    "existing-cake": {
      "commands": [
        {
          "executable": "dotnet",
          "arguments": [
            "restore",
            "build/Build.csproj",
            "--locked-mode"
          ]
        },
        {
          "executable": "pwsh",
          "script": "build/steps/ci-cake.ps1",
          "shell": "pwsh"
        }
      ]
    },
    "documentation": {
      "commands": [
        {
          "executable": "dotnet",
          "arguments": [
            "tool",
            "restore"
          ]
        },
        {
          "executable": "dotnet",
          "arguments": [
            "restore",
            "TeslaPowerwallLibrary.slnx"
          ]
        },
        {
          "executable": "dotnet",
          "arguments": [
            "build",
            "TeslaPowerwallLibrary.slnx",
            "--configuration",
            "Release",
            "--no-restore",
            "-p:GenerateDocfxDocumentation=false"
          ]
        },
        {
          "executable": "dotnet",
          "arguments": [
            "test",
            "TeslaPowerwallLibrary.Tests/TeslaPowerwallLibrary.Tests.csproj",
            "--configuration",
            "Release",
            "--no-build",
            "--framework",
            "net472",
            "--filter",
            "TestCategory!=Live"
          ]
        },
        {
          "executable": "dotnet",
          "arguments": [
            "test",
            "TeslaPowerwallLibrary.Tests/TeslaPowerwallLibrary.Tests.csproj",
            "--configuration",
            "Release",
            "--no-build",
            "--framework",
            "net10.0",
            "--filter",
            "TestCategory!=Live"
          ]
        },
        {
          "executable": "dotnet",
          "arguments": [
            "tool",
            "run",
            "docfx",
            "docfx_project/docfx.json"
          ]
        }
      ],
      "documentation": {
        "config": "docfx_project/docfx.json",
        "site": "docfx_project/_site",
        "title": "TeslaPowerwallLibrary"
      }
    },
    "xml-documentation": {
      "commands": [
        {
          "executable": "dotnet",
          "arguments": [
            "--version"
          ]
        }
      ]
    }
  },
  "xmlDocumentation": {
    "projects": [
      "TeslaPowerwallLibrary/TeslaPowerwallLibrary.csproj",
      "TeslaPowerwallLibrary.Login/TeslaPowerwallLibrary.Login.csproj"
    ]
  }
}
