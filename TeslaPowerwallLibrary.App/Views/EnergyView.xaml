<UserControl x:Class="TeslaPowerwallLibrary.App.Views.EnergyView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="clr-namespace:TeslaPowerwallLibrary.App.ViewModels"
			 xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
			 d:DataContext="{d:DesignInstance Type=vm:EnergyViewModel}"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 Background="{StaticResource BackgroundBrush}">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0" Text="Energy" Style="{StaticResource HeadingText}" Margin="8,0,8,8" />
		<TextBlock Grid.Row="0" Text="{Binding SiteLabel}" Style="{StaticResource MutedText}"
					HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8,0,8,8"
					Visibility="{Binding SiteLabel, Converter={StaticResource NullToCollapsed}}" />

		<StackPanel x:Name="HistorySetup" Grid.Row="1" Margin="8,0,8,12"
			Visibility="{Binding IsLocal, Converter={StaticResource BoolToVisibility}}"
			IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
			<TextBlock Text="Cloud account for past history (live readings stay on LAN)" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
			<WrapPanel>
				<ComboBox Width="95" ItemsSource="{Binding HistoryProviders}" SelectedItem="{Binding HistoryProvider}" />
				<Button Content="{Binding HistoryAccountAction}" Command="{Binding ConnectHistoryCommand}" Margin="8,0,8,0" />
				<ComboBox Visibility="{Binding HasBoundHistorySite, Converter={StaticResource InverseBoolToVisibility}}" Width="225" ItemsSource="{Binding HistorySites}" SelectedItem="{Binding SelectedHistorySite}" DisplayMemberPath="SiteName" />
				<Button Visibility="{Binding HasBoundHistorySite, Converter={StaticResource InverseBoolToVisibility}}" Content="Use site" Command="{Binding UseHistorySiteCommand}" Margin="8,0,0,0" />
			</WrapPanel>
		</StackPanel>

		<StackPanel Grid.Row="4" Margin="8,0,8,8">
			<TextBlock Text="{Binding LiveReadingText}" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"
				Visibility="{Binding IsLocal, Converter={StaticResource BoolToVisibility}}" />
			<TextBlock Text="{Binding HistorySourceLabel}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
			<TextBlock Text="{Binding LiveStorageWarning}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
		</StackPanel>

		<!-- Period selector -->
		<StackPanel x:Name="PeriodControls" Grid.Row="2" Orientation="Horizontal" Margin="8,0,8,12"
			Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibility}}"
			IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
			<TextBlock Text="Period" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
						Margin="0,0,10,0" />
			<ComboBox Width="160" ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" />
			<Button Content="&#x25C0;" Command="{Binding PreviousPeriodCommand}" Margin="12,0,0,0"
					MinWidth="34" ToolTip="Previous period" />
			<TextBlock Text="{Binding PeriodLabel}" VerticalAlignment="Center" MinWidth="150"
						TextAlignment="Center" Foreground="{StaticResource TextBrush}" Margin="8,0,8,0" />
			<Button Content="&#x25B6;" Command="{Binding NextPeriodCommand}" MinWidth="34"
					ToolTip="Next period" />
			<Button Content="Refresh from cloud" Command="{Binding RefreshHistoryCommand}" Margin="12,0,0,0"
					IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
		</StackPanel>

		<!-- Component picker: exactly one of Solar / Home / Powerwall™ / Grid is graphed at a time, matching
			  the Tesla™ app's own single-series presentation, instead of combining every component onto one
			  chart. The shared GroupName makes the RadioButtons mutually exclusive in the UI; the view model
			  also enforces the invariant itself (see EnergyViewModel.OnComponentSelectionChanged). -->
		<ItemsControl Grid.Row="3" ItemsSource="{Binding Components}" Margin="8,0,8,12"
			Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibility}}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<WrapPanel Orientation="Horizontal" />
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<RadioButton GroupName="EnergyComponent" IsChecked="{Binding IsSelected}" Margin="0,0,18,0"
								 VerticalContentAlignment="Center">
						<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
							<Border Width="12" Height="12" CornerRadius="3" Margin="0,0,6,0"
									Background="{Binding Swatch}" />
							<TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" />
						</StackPanel>
					</RadioButton>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<!-- Chart -->
		<Border Grid.Row="5" Style="{StaticResource Card}">
			<Grid>
			<lvc:CartesianChart x:Name="HistoryChart" Visibility="{Binding HasChartData, Converter={StaticResource BoolToVisibility}}" Series="{Binding Series, NotifyOnTargetUpdated=True}" TargetUpdated="OnChartDataChanged"
								XAxes="{Binding XAxes}"
								YAxes="{Binding YAxes}"
								LegendPosition="Bottom" AnimationsSpeed="0:0:0" />
			<StackPanel x:Name="EmptyHistory" VerticalAlignment="Center" Margin="32"
				Visibility="{Binding HasChartData, Converter={StaticResource InverseBoolToVisibility}}">
				<TextBlock Text="Energy history" Style="{StaticResource HeadingText}" Margin="0,0,0,12" />
				<TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
			</StackPanel>
			</Grid>
		</Border>

		<TextBlock Grid.Row="6" Text="{Binding StatusMessage}" Foreground="{StaticResource MutedTextBrush}"
					Margin="8,8,8,0" TextWrapping="Wrap"
					Visibility="{Binding HasChartData, Converter={StaticResource BoolToVisibility}}" />
	</Grid>
</UserControl>
